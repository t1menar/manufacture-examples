# Pinned versions of the Manufacture components the examples are built and checked against.
# Keep SDK_REF in sync with [tool.uv.sources] in pyproject.toml (a test checks it).
SDK_REPO=https://github.com/t1menar/manufacture-sdk-python
SDK_REF=d7caeca7a3a39cb41b76cd118fca91b7e73636bb
# manufacture-core commit of the release contract-v0.2.1 (`manufacture validate`).
CORE_REF=3299ffe51c7c00de2f2526ebdb95d0da3c1d00b8
# Core image for the compose e2e (e2e/run.sh). EMPTY until manufacture-core publishes a
# runnable image (C4 engine + C5 registration + C6 docker driver/image), e.g.
#   CORE_IMAGE=ghcr.io/t1menar/manufacture-core:main
# While empty, the e2e brings up and checks the infrastructure only.
CORE_IMAGE=
